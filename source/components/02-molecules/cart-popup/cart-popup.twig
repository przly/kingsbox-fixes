{# TODO : Toggle 'is-open-cart' Class #}
<div
	data-component="mol-cart-popup"
	class="cart-popup {{ cart_popup.boolean__is_empty ? 'cart-popup--empty' }} {{ extra_class }}"
>
	<div class="cart-popup__overlay : covered"></div>
	<div class="cart-popup__inner" data-lenis-prevent>
		{# Everything but the footer scrolls. cart-popup.js moves __footer out of __content, after this #}
		<div class="cart-popup__scroll">
			{% if cart_popup.text__title %}
				<div class="cart-popup__header">
					<div class="cart-popup__title">
						{% include '@atoms/title/title.twig' with {
							modifier: 'h4',
							tag: 'h2',
							secondary: true,
							title: cart_popup.text__title
						} %}

						<div class="cart-popup__number : text--md : text--gray-400 : text--12 : font-secondary">
							[{{ cart_popup.text__number }}]
						</div>
					</div>

					<div class="cart-popup__header-right">
						{% include '@atoms/button/button.twig' with {
							class_name: 'cart-popup__copy-btn',
							modifier: 'white',
							mono_font: true,
							text: cart_popup.text__copy_button,
							data_attr: "data-copy-button data-copy-text='" ~ cart_popup.text__copy_text ~ "'",
							icon: 'copy'
						} %}

						{% include '@atoms/button/button.twig' with {
							class_name: 'cart-popup__close',
							modifier: 'gray',
							aria_label: 'Close Popup',
							icon: 'close',
							type: 'button'
						} %}
					</div>
				</div>
			{% endif %}

			<div class="cart-popup__content">
				{% include '@molecules/cart-popup-content-axios/cart-popup-content-axios.twig' with {
					cart_popup: cart_popup
				} %}
			</div>

			{% if cart_popup.empty.text__title or cart_popup.empty.text__text or cart_popup.empty.link__link %}
				<div class="cart-popup__empty">
					<div class="cart-popup__empty-body : text-center : d-flex-cc">
						{% if cart_popup.empty.image__image %}
							<div class="cart-popup__empty-image">
								<img
									src="{{ cart_popup.empty.image__image }}"
									alt="{{ cart_popup.empty.image_alt }}"
									width="282"
									height="138"
								/>
							</div>
						{% endif %}
						{% if cart_popup.empty.text__title %}
							<div class="cart-popup__empty-title">
								{% include '@atoms/title/title.twig' with {
									modifier: 'h5',
									tag: 'h2',
									title: cart_popup.empty.text__title
								} %}
							</div>
						{% endif %}
						{% if cart_popup.empty.text__text %}
							<div class="cart-popup__empty-text : text--14 : text--md : text--gray-400">
								{{ cart_popup.empty.text__text }}
							</div>
						{% endif %}
						{% if cart_popup.empty.link__link %}
							{% include '@atoms/button/button.twig' with {
								has_loader: true,
								href: cart_popup.empty.link__link,
								text: cart_popup.empty.link_text,
								target: cart_popup.empty.link_target,
								rel: cart_popup.empty.link_rel
							} %}
						{% endif %}
					</div>
				</div>
			{% endif %}

			{% if cart_popup.product_list.text__title or cart_popup.product_list.repeater__items %}
				<div class="cart-popup__product-list">
					{% if cart_popup.product_list.text__title %}
						<div class="cart-popup__product-list-title : mb-24">
							{% include '@atoms/title/title.twig' with {
								modifier: 'h5',
								tag: 'h2',
								secondary: true,
								title: cart_popup.product_list.text__title
							} %}
						</div>
					{% endif %}

					{% if cart_popup.product_list.repeater__items %}
						<div class="cart-popup__product-row">
							{% for item in cart_popup.product_list.repeater__items %}
								{% include '@molecules/product-card/product-card.twig' with {
									product_card: item
								} %}
							{% endfor %}
						</div>
					{% endif %}
				</div>
			{% endif %}
		</div>
	</div>
</div>
